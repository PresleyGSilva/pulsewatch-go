# Copy to .env and adjust. Ports are mapped from these variables.
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch
POSTGRES_DB=pulsewatch
DB_PORT=5439
API_PORT=8086
WEB_PORT=3006
DATABASE_URL=postgres://pulsewatch:pulsewatch@localhost:5439/pulsewatch?sslmode=disable
JWT_SECRET=change-me-to-at-least-16-chars
NEXT_PUBLIC_API_URL=http://localhost:8086
SEED=1
