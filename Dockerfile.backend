# ---- build ----
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/pulsewatch ./cmd/api && \
    CGO_ENABLED=0 go build -o /out/seed ./cmd/seed

# ---- run ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/pulsewatch /out/seed ./
COPY migrations ./migrations
COPY openapi.yaml ./openapi.yaml
ENV PORT=8086
EXPOSE 8086
HEALTHCHECK --interval=15s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:8086/healthz | grep -q ok
CMD ["./pulsewatch"]
